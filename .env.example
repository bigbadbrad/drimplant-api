NODE_ENV=development
PORT=3005

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=drimplant_db
DB_USER=root
DB_PASSWORD=

# JWT secret for future dashboard login. Local placeholder only.
SECRET=change-me-locally

# Optional. Comma-separated browser origins allowed to call this API.
# Local widget is :5173; local site is usually :3000 or :3001.
# Production (set on Aptible):
# CORS_ORIGIN=https://drimplant-widget.netlify.app,https://dr-implant.netlify.app
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://localhost:3001

# Optional. If set, public /v1 routes require header x-api-key.
PUBLIC_API_KEY=

# PostHog (optional locally). Capture/identify is skipped when unset.
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_API_KEY=
POSTHOG_PROJECT_ID=

# Salesforce (optional locally). Generic client is unused until configured.
SALESFORCE_LOGIN_URL=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_USERNAME=
SALESFORCE_PASSWORD=
